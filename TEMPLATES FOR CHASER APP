                <div>
                    <h5 class="mb-0 text-warning fw-bold">Direct Message with {{ recipient.username }}</h5>
                    <small class="text-muted">{{ recipient.bio }}</small>
                </div>
            </div>
            <div id="dm-box" class="card-body" style="height: 450px; overflow-y: scroll; display: flex; flex-direction: column; gap: 10px;">
                {% for dm in dms %}
                <div class="d-flex align-items-start p-2 rounded bg-black border border-secondary {% if dm.sender_id == current_user.id %}ms-auto border-warning{% endif %}" style="max-width: 80%;">
                    <img src="{{ url_for('static', filename='uploads/' + dm.sender.profile_pic) }}" class="avatar-sm me-2 chaser-img" onclick="openLightbox(this.src)" style="width: 30px; height: 30px;" alt="Avatar">
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold text-warning small">{{ dm.sender.username }}</span>
