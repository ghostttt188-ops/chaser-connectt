{% extends "base.html" %}
{% block content %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow mb-3 border border-warning">
            <div class="card-header bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-warning">💬 Nationwide Field Command Chat</h5>
                <small class="text-muted">Instant WebSocket Comms</small>
            </div>
            <div id="chat-box" class="card-body" style="height: 500px; overflow-y: scroll; display: flex; flex-direction: column; gap: 10px;">
                {% for msg in messages %}
                <div class="d-flex align-items-start p-2 rounded bg-black border border-secondary">
                    <img src="{{ url_for('static', filename='uploads/' + msg.author_user.profile_pic) }}" class="avatar-sm me-3 chaser-img" onclick="openLightbox(this.src)" alt="Avatar">
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <a href="/profile/{{ msg.author_user.id }}" class="fw-bold text-warning text-decoration-none">{{ msg.author_user.username }}</a>
                        </div>
                        <p class="mb-0 text-light fs-6 mt-1">{{ msg.content }}</p>
                    </div>
                </div>
                {% else %}
                <div id="no-chat" class="text-center text-muted py-5">
                    <p>No chat messages yet. Drop the first transmission from the field!</p>
                </div>
                {% endfor %}
            </div>
            <div class="card-footer bg-dark border-top border-secondary">
                <form id="chat-form" class="d-flex gap-2">
                    <input type="text" id="chat-input" class="form-control" placeholder="Transmit live field update..." required autocomplete="off">
                    <button type="submit" class="btn btn-fb fw-bold px-4">Send</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const socket = io();
    const chatBox = document.getElementById('chat-box');
    const chatForm = document.getElementById('chat-form');
    const chatInput = document.getElementById('chat-input');

    chatForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const text = chatInput.value.trim();
        if (text) {
            socket.emit('send_message', { content: text });
            chatInput.value = '';
        }
    });

    socket.on('receive_message', function(data) {
        const noChat = document.getElementById('no-chat');
        if (noChat) noChat.remove();

        const msgDiv = document.createElement('div');
        msgDiv.className = 'd-flex align-items-start p-2 rounded bg-black border border-secondary';
        msgDiv.innerHTML = '<img src="/static/uploads/' + data.profile_pic + '" class="avatar-sm me-3 chaser-img" onclick="openLightbox(this.src)" alt="Avatar"><div><div class="d-flex align-items-center gap-2"><a href="/profile/' + data.user_id + '" class="fw-bold text-warning text-decoration-none">' + data.username + '</a></div><p class="mb-0 text-light fs-6 mt-1">' + data.content + '</p></div>';
        chatBox.appendChild(msgDiv);
        chatBox.scrollTop = chatBox.scrollHeight;
    });

    chatBox.scrollTop = chatBox.scrollHeight;
</script>
{% endblock %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>⚡ ChaserConnect | Professional Command Network</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.5.1/socket.io.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
        body { background-color: #0d0e12; color: #f0f2f5; font-family: system-ui, -apple-system, sans-serif; }
        .navbar { background-color: #16181d; border-bottom: 2px solid #ffaa00; box-shadow: 0 4px 20px rgba(0,0,0,0.6); }
        .card { background-color: #1a1d24; border: 1px solid #2d323d; color: #f0f2f5; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.4); }
        .form-control, .form-control:focus { background-color: #262a33; color: #fff; border: 1px solid #3f4756; }
        .form-control::placeholder { color: #8c96a6; opacity: 1; }
        .btn-fb { background-color: #ffaa00; color: #0d0e12; font-weight: 800; border: none; }
        .btn-fb:hover { background-color: #e09600; color: #0d0e12; }
        .avatar-sm { width: 38px; height: 38px; object-fit: cover; border-radius: 50%; border: 2px solid #ffaa00; }
        .avatar-md { width: 48px; height: 48px; object-fit: cover; border-radius: 50%; border: 2px solid #3f4756; }
        .avatar-lg { width: 90px; height: 90px; object-fit: cover; border-radius: 50%; border: 3px solid #ffaa00; }
        a { color: #ffaa00; text-decoration: none; }
        a:hover { color: #ffc44d; text-decoration: underline; }
        .chaser-img { cursor: pointer; opacity: 0.95; transition: opacity 0.2s; }
        .chaser-img:hover { opacity: 1; }
        #lightbox-modal { display: none; position: fixed; z-index: 9999; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); align-items: center; justify-content: center; }
        #lightbox-modal img { max-width: 90%; max-height: 90%; border-radius: 8px; }
        #lightbox-close { position: absolute; top: 20px; right: 30px; color: #fff; font-size: 40px; font-weight: bold; cursor: pointer; }
        .nws-banner { background-color: #b30000; color: #ffffff; font-size: 0.9rem; font-weight: bold; padding: 8px 15px; border-bottom: 2px solid #ffaa00; white-space: nowrap; overflow: hidden; position: relative; }
        .nws-banner marquee { width: 100%; }
        .reaction-bar { display: flex; gap: 5px; }
    </style>
</head>
<body>
    <div class="nws-banner">
        <marquee scrollamount="5" id="nws-ticker">⚡ LIVE NWS FEED: Connecting to National Weather Service active warning database...</marquee>
    </div>

    <nav class="navbar navbar-expand-lg navbar-dark px-4 sticky-top">
        <a class="navbar-brand fw-bold text-warning fs-4 d-flex align-items-center gap-2" href="/">
            <span style="font-size: 1.4rem;">⚡</span> ChaserConnect
        </a>
        {% if current_user.is_authenticated %}
        <div class="ms-auto d-flex align-items-center gap-3 flex-wrap py-1">
            <a href="/" class="text-light text-decoration-none fw-semibold">🏠 Feed</a>
            <a href="/chat" class="text-warning text-decoration-none fw-semibold">💬 Command Chat</a>
            <a href="/dm/1" class="text-info text-decoration-none fw-semibold">📬 Direct Messages</a>
            <a href="/map" class="text-warning text-decoration-none fw-semibold">🗺️ Threat Map</a>
            <a href="/shelters" class="text-success text-decoration-none fw-semibold">🛡️ Shelters</a>
            <a href="/spc" class="text-danger text-decoration-none fw-semibold">📈 SPC Outlooks</a>
            <a href="/dispatches" class="text-warning text-decoration-none fw-semibold">🚨 Dispatches</a>
            
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center text-decoration-none text-light dropdown-toggle" data-bs-toggle="dropdown">
                    <img src="{{ url_for('static', filename='uploads/' + current_user.profile_pic) }}" class="avatar-sm me-2" alt="Profile">
                    <span class="fw-semibold">{{ current_user.username }}</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-dark bg-dark border border-secondary shadow">
                    <li><a class="dropdown-item" href="{{ url_for('profile', user_id=current_user.id) }}">👤 View Profile</a></li>
                    <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#editProfileModal">⚙️ Edit Profile & PFP</a></li>
                    <li><hr class="dropdown-divider border-secondary"></li>
                    <li><a class="dropdown-item text-danger" href="{{ url_for('logout') }}">Log Out</a></li>
                </ul>
            </div>
        </div>
        {% endif %}
    </nav>

    {% if current_user.is_authenticated %}
    <div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content bg-dark text-light border border-secondary shadow-lg">
          <div class="modal-header border-bottom border-secondary">
            <h5 class="modal-title text-warning fw-bold">⚙️ Edit Chaser Profile & Avatar</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form action="/update_profile" method="POST" enctype="multipart/form-data">
              <div class="modal-body">
                  <div class="text-center mb-3">
                      <img src="{{ url_for('static', filename='uploads/' + current_user.profile_pic) }}" class="avatar-lg mb-2 shadow" alt="Current PFP">
                  </div>
                  <div class="mb-3">
                      <label class="form-label text-light small fw-bold">New Profile Picture (PFP)</label>
                      <input type="file" class="form-control text-light" name="profile_pic" accept="image/*">
                  </div>
                  <div class="mb-3">
                      <label class="form-label text-light small fw-bold">Chaser Bio / Target Regions</label>
                      <textarea class="form-control" name="bio" rows="3" required>{{ current_user.bio }}</textarea>
                  </div>
              </div>
              <div class="modal-footer border-top border-secondary">
                  <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn btn-fb btn-sm fw-bold">Save Changes</button>
              </div>
          </form>
        </div>
      </div>
    </div>
    {% endif %}

    <div class="container py-4">
        {% with messages = get_flashed_messages(with_categories=true) %}
          {% if messages %}
            {% for category, message in messages %}
              <div class="alert alert-{{ category }} alert-dismissible fade show shadow" role="alert">
                {{ message }}
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            {% endfor %}
          {% endif %}
        {% endwith %}
        {% block content %}{% endblock %}
    </div>

    <div id="lightbox-modal" onclick="closeLightbox()">
        <span id="lightbox-close">&times;</span>
        <img id="lightbox-img" src="" alt="Zoomed Photo">
    </div>

    <script>
        function openLightbox(imgSrc) {
            document.getElementById('lightbox-img').src = imgSrc;
            document.getElementById('lightbox-modal').style.display = 'flex';
        }
        function closeLightbox() {
            document.getElementById('lightbox-modal').style.display = 'none';
        }

        function fetchNWSAlerts() {
            fetch('/api/nws_alerts')
                .then(res => res.json())
                .then(data => {
                    if (data && data.length > 0) {
                        let text = data.map(alert => '⚠️ [' + alert.severity.toUpperCase() + '] ' + alert.headline + ' (' + alert.area + ')').join(' &nbsp;&nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;&nbsp; ');
                        document.getElementById('nws-ticker').innerHTML = text;
                    } else {
                        document.getElementById('nws-ticker').innerHTML = '🟢 NWS STATUS: No active tornado or severe thunderstorm warnings reported nationwide at this moment.';
                    }
                }).catch(err => {
                    document.getElementById('nws-ticker').innerHTML = '🟢 NWS STATUS: Monitoring severe weather systems nationwide.';
                });
        }
        fetchNWSAlerts();
        setInterval(fetchNWSAlerts, 60000);
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
