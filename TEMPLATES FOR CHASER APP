                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const socket = io();
    const dmBox = document.getElementById('dm-box');
    dmBox.scrollTop = dmBox.scrollHeight;

    const currentUserId = {{ current_user.id }};
    const recipientId = {{ recipient.id }};

    socket.on('receive_dm', function(data) {
        if ((data.sender_id === currentUserId && data.recipient_id === recipientId) ||
            (data.sender_id === recipientId && data.recipient_id === currentUserId)) {
            
            const noDms = document.getElementById('no-dms');
            if (noDms) noDms.remove();

            const isMe = data.sender_id === currentUserId;
            const msgDiv = document.createElement('div');
            msgDiv.className = 'd-flex align-items-start p-2 rounded bg-black border border-secondary ' + (isMe ? 'ms-auto border-warning' : '');
            msgDiv.style.maxWidth = '80%';
            msgDiv.innerHTML = '<img src="/static/uploads/' + data.sender_pic + '" class="avatar-sm me-2 chaser-img" onclick="openLightbox(this.src)" style="width: 30px; height: 30px;" alt="Avatar"><div><div class="d-flex align-items-center gap-2"><span class="fw-bold text-warning small">' + data.sender_username + '</span><small class="text-muted" style="font-size: 0.7rem;">Just now</small></div><p class="mb-0 text-light fs-6 mt-1">' + data.content + '</p></div>';
            dmBox.appendChild(msgDiv);
            dmBox.scrollTop = dmBox.scrollHeight;
        }
    });
</script>
{% endblock %}
