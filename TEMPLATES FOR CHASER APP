                            <a href="https://www.spc.noaa.gov/products/outlook/day3otlk.html" target="_blank" class="btn btn-outline-warning btn-sm">Full Day 3 Discussion</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
